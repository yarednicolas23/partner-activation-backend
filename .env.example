# Servidor
PORT=3000
NODE_ENV=development

# Supabase (proyecto dev) — ver plan-fase1-infraestructura-autenticacion.md
# Panel Supabase → Project Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# "Secret keys" → sb_secret_... (NUNCA la publishable/anon key acá — este
# cliente bypassa RLS y usa la Admin API de Supabase Auth)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key-here
