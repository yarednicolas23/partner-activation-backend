# Servidor
PORT=3000
NODE_ENV=development

# Supabase (proyecto dev) — ver plan-fase1-infraestructura-autenticacion.md
# Panel Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Panel Supabase → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# AWS S3 (evidencias de misiones) — ver backend/infra/terraform/s3.tf
AWS_REGION=eu-central-1
AWS_S3_BUCKET=pap-dev-evidence
# IAM user dedicado (infra/terraform/s3.tf) — terraform output -raw backend_s3_access_key_id / backend_s3_secret_access_key
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Resend (email transaccional — bienvenida, milestones, lembretes) —
# resend.com/api-keys. Reemplaza a AWS SES (quedaba en modo sandbox).
RESEND_API_KEY=your-resend-api-key
# Debe ser un remitente de un dominio verificado en Resend (resend.com/domains)
RESEND_FROM_EMAIL=noreply@your-verified-domain.com
